{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tuldok:contribution-v1",
  "type": "object",
  "properties": {
    "format": {
      "const": "tuldok_contribution_v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}:[a-z][a-z0-9_.-]{0,63}$",
      "maxLength": 129
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "maxLength": 32
    },
    "kind": {
      "enum": [
        "task",
        "reader",
        "model",
        "trainer",
        "evaluator",
        "view"
      ]
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\u0000-\\u001f\\u007f<>]+$"
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,63}:[a-z][a-z0-9_.-]{0,63}$",
            "maxLength": 129
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
            "maxLength": 32
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "version",
          "sha256"
        ],
        "additionalProperties": false
      },
      "maxItems": 64
    },
    "parameters": {
      "$ref": "urn:tuldok:parameter-v1"
    },
    "defaults": {
      "type": "object",
      "maxProperties": 64
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
            "maxLength": 64
          },
          "direction": {
            "enum": [
              "input",
              "target",
              "output"
            ]
          },
          "contract": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,63}:[a-z][a-z0-9_.-]{0,63}$",
                "maxLength": 129
              },
              "version": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
                "maxLength": 32
              }
            },
            "required": [
              "id",
              "version"
            ],
            "additionalProperties": false
          },
          "encoding": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
            "maxLength": 64
          },
          "axes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
              "maxLength": 64
            },
            "maxItems": 8
          },
          "units": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^\\u0000-\\u001f\\u007f<>]+$"
          }
        },
        "required": [
          "id",
          "direction",
          "contract",
          "encoding",
          "axes",
          "units"
        ],
        "additionalProperties": false
      },
      "maxItems": 32
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
            "maxLength": 64
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
            "maxLength": 32
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
              "maxLength": 64
            },
            "maxItems": 64,
            "uniqueItems": true
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
              "maxLength": 64
            },
            "maxItems": 64,
            "uniqueItems": true
          },
          "clock": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
            "maxLength": 64
          },
          "failure_policy": {
            "const": "fail"
          }
        },
        "required": [
          "id",
          "version",
          "inputs",
          "outputs",
          "clock",
          "failure_policy"
        ],
        "additionalProperties": false
      },
      "maxItems": 16,
      "minItems": 1
    },
    "implementation": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f\\\\]+$"
        },
        "entrypoint": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        }
      },
      "required": [
        "source",
        "entrypoint"
      ],
      "additionalProperties": false
    },
    "view": {
      "type": "object",
      "properties": {
        "primitive": {
          "enum": [
            "metadata",
            "scalar_curve",
            "table",
            "orthogonal_slices"
          ]
        },
        "query": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,63}:[a-z][a-z0-9_.-]{0,63}$",
              "maxLength": 129
            },
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
              "maxLength": 32
            }
          },
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": false
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\u0000-\\u001f\\u007f<>]+$"
        }
      },
      "required": [
        "primitive",
        "query",
        "label"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "id",
    "version",
    "kind",
    "label",
    "requires"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "view"
          }
        }
      },
      "then": {
        "required": [
          "view"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "implementation"
              ]
            },
            {
              "required": [
                "stages"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "reader",
              "model",
              "trainer",
              "evaluator"
            ]
          }
        }
      },
      "then": {
        "required": [
          "implementation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "trainer"
          }
        }
      },
      "then": {
        "required": [
          "parameters",
          "defaults",
          "stages"
        ]
      }
    }
  ]
}
