{
  "$defs": {
    "DecisionAnswer": {
      "oneOf": [
        {
          "properties": {
            "choice": {
              "type": "string"
            },
            "confidence": {
              "format": "double",
              "type": "number"
            },
            "probabilities": {
              "additionalProperties": {
                "format": "double",
                "type": "number"
              },
              "type": "object"
            },
            "type": {
              "const": "choice",
              "type": "string"
            }
          },
          "required": [
            "type",
            "choice",
            "probabilities",
            "confidence"
          ],
          "type": "object"
        },
        {
          "properties": {
            "confidence": {
              "format": "double",
              "type": "number"
            },
            "legend": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "probabilities": {
              "additionalProperties": {
                "format": "double",
                "type": "number"
              },
              "type": "object"
            },
            "score": {
              "description": "Probability-weighted level index; may fall between levels.",
              "format": "double",
              "type": "number"
            },
            "type": {
              "const": "score",
              "type": "string"
            }
          },
          "required": [
            "type",
            "score",
            "legend",
            "probabilities",
            "confidence"
          ],
          "type": "object"
        },
        {
          "properties": {
            "noul": {
              "description": "Probability that the answer is true.",
              "format": "double",
              "type": "number"
            },
            "type": {
              "const": "noul",
              "type": "string"
            }
          },
          "required": [
            "type",
            "noul"
          ],
          "type": "object"
        }
      ]
    },
    "FinishReason": {
      "enum": [
        "stop",
        "length",
        "content_filter"
      ],
      "type": "string"
    },
    "OperationResult": {
      "oneOf": [
        {
          "properties": {
            "finish_reason": {
              "$ref": "#/$defs/FinishReason"
            },
            "kind": {
              "const": "text",
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text",
            "finish_reason"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "embeddings",
              "type": "string"
            },
            "vectors": {
              "items": {
                "items": {
                  "format": "float",
                  "type": "number"
                },
                "type": "array"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "vectors"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "image",
              "type": "string"
            },
            "png_base64": {
              "type": "string"
            },
            "seed": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "png_base64",
            "seed"
          ],
          "type": "object"
        },
        {
          "properties": {
            "answers": {
              "additionalProperties": {
                "$ref": "#/$defs/DecisionAnswer"
              },
              "type": "object"
            },
            "input_tokens": {
              "description": "Prompt tokens evaluated across all questions, when reported.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "kind": {
              "const": "decisions",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "answers"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "contract_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "request_id": {
      "type": "string"
    },
    "result": {
      "$ref": "#/$defs/OperationResult"
    }
  },
  "required": [
    "contract_version",
    "request_id",
    "result"
  ],
  "title": "OperationResponse",
  "type": "object"
}
