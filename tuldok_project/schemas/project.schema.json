{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tuldok.invalid/schemas/project.schema.json",
  "title": "Tuldok project folder: tuldok.json",
  "description": "The tuldok.json file at the top of a project folder (tuldok_project_v1).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "name"
  ],
  "properties": {
    "format": {
      "const": "tuldok_project_v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "description": "32 lowercase hexadecimal characters"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "code_root": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/]",
      "description": "a relative path from the project folder to the code root, never absolute"
    },
    "code_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "description": "1 to 64 paths relative to the code root: the parts of the repository a run needs",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "groups": {
      "type": "array",
      "maxItems": 200,
      "description": "0 to 200 groups, in the order their sections are shown",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/group_id"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "parent": {
            "$ref": "#/$defs/group_id"
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chart"
      ],
      "properties": {
        "chart": {
          "type": "string",
          "pattern": "^charts/[a-z0-9][a-z0-9._-]{0,119}$",
          "description": "a reference to a chart of the form progression, such as charts/<name>"
        }
      }
    }
  },
  "$defs": {
    "group_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "description": "a group id of letters, digits, '_', '.' or '-' that starts with a letter or digit, at most 64 characters"
    }
  }
}
