{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tuldok.invalid/schemas/environment.schema.json",
  "title": "Tuldok environment definition",
  "description": "One environment definition in environments/<name>.json (tuldok_definition_v1). Rules JSON Schema cannot express are checked in tuldok_project/check.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "kind",
    "title",
    "python",
    "device",
    "packages"
  ],
  "properties": {
    "format": {
      "const": "tuldok_definition_v1"
    },
    "kind": {
      "enum": [
        "dataset",
        "model",
        "recipe",
        "benchmark",
        "step",
        "environment",
        "chart",
        "annotation"
      ]
    },
    "title": {
      "$ref": "#/$defs/title"
    },
    "description": {
      "$ref": "#/$defs/description"
    },
    "card": {
      "$ref": "#/$defs/card"
    },
    "labels": {
      "$ref": "#/$defs/labels"
    },
    "python": {
      "type": "string",
      "pattern": "^3\\.(0|[1-9][0-9]*)$",
      "description": "a Python version written 3.<minor>, such as 3.12"
    },
    "device": {
      "enum": [
        "cpu",
        "cuda"
      ]
    },
    "packages": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9]([A-Za-z0-9._-]*[A-Za-z0-9])?$",
        "description": "a package name such as numpy"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9A-Za-z][0-9A-Za-z.+!_-]*$",
        "description": "an exact version such as 2.3.5, with no comparison operators"
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirements"
      ],
      "properties": {
        "requirements": {
          "$ref": "#/$defs/path"
        },
        "index_urls": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "pattern": "^https://\\S+$",
            "description": "an https:// URL"
          }
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "card": {
      "type": "string",
      "pattern": "^notes/",
      "description": "a path under notes/, such as notes/<name>.md"
    },
    "labels": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {
        "type": "string",
        "maxLength": 400
      }
    }
  }
}
