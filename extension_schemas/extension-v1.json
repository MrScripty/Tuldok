{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tuldok:extension-v1",
  "type": "object",
  "properties": {
    "format": {
      "const": "tuldok_extension_v1"
    },
    "package": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "maxLength": 32
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\u0000-\\u001f\\u007f<>]+$"
    },
    "license": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[^\\u0000-\\u001f\\u007f<>]+$"
        },
        "notices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[^\\u0000-\\u001f\\u007f\\\\]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8388608
              }
            },
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "additionalProperties": false
          },
          "maxItems": 16
        }
      },
      "required": [
        "id",
        "notices"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\u0000-\\u001f\\u007f\\\\]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8388608
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      },
      "maxItems": 64
    },
    "host_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,63}:[a-z][a-z0-9_.-]{0,63}$",
            "maxLength": 129
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
            "maxLength": 32
          }
        },
        "required": [
          "id",
          "version"
        ],
        "additionalProperties": false
      },
      "maxItems": 32,
      "minItems": 1
    },
    "runtime": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
          "maxLength": 64
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "profile"
      ],
      "additionalProperties": false
    },
    "effects": {
      "type": "array",
      "items": {
        "enum": [
          "filesystem",
          "network",
          "subprocess"
        ]
      },
      "maxItems": 3,
      "uniqueItems": true
    },
    "resources": {
      "type": "object",
      "properties": {
        "wall_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "source_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        }
      },
      "required": [
        "wall_seconds",
        "source_bytes",
        "output_bytes"
      ],
      "additionalProperties": false
    },
    "contributions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,63}:[a-z][a-z0-9_.-]{0,63}$",
            "maxLength": 129
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
            "maxLength": 32
          },
          "kind": {
            "enum": [
              "task",
              "reader",
              "model",
              "trainer",
              "evaluator",
              "view"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\u0000-\\u001f\\u007f\\\\]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65536
          }
        },
        "required": [
          "id",
          "version",
          "kind",
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      },
      "maxItems": 64,
      "minItems": 1
    }
  },
  "required": [
    "format",
    "package",
    "label",
    "license",
    "sources",
    "host_contracts",
    "runtime",
    "effects",
    "resources",
    "contributions"
  ],
  "additionalProperties": false
}
