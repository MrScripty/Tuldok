{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tuldok:parameter-v1",
  "$ref": "#/$defs/parameter",
  "$defs": {
    "parameter": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "object",
            "array",
            "string",
            "number",
            "integer",
            "boolean"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\u0000-\\u001f\\u007f<>]+$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f<>]+$"
        },
        "properties": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
            "maxLength": 64
          },
          "additionalProperties": {
            "$ref": "#/$defs/parameter"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
            "maxLength": 64
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "additionalProperties": {
          "const": false
        },
        "items": {
          "$ref": "#/$defs/parameter"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "minItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "enum": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean"
            ]
          },
          "maxItems": 64,
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "object"
              }
            }
          },
          "then": {
            "required": [
              "properties",
              "additionalProperties"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "array"
              }
            }
          },
          "then": {
            "required": [
              "items",
              "maxItems"
            ]
          }
        }
      ]
    }
  }
}
